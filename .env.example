# Copy to .env and fill in. The real .env is gitignored.

# Postgres (pgvector). For local dev this matches docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slidecorpus

# OpenAI (text embeddings). Required for ingest and for /health to pass.
OPENAI_API_KEY=

# Path to the tagged JSON corpus (read-only). Points at the tagging service output.
CORPUS_PATH=../slide_tagging/reference_data/hand_labels

# Path to source .pptx decks, for serving one reference slide raw (get_slide_pptx).
# Deploy default is corpus/source; for local dev against the sibling repo use:
SOURCE_PPTX_PATH=../slide_tagging/data/source

# Base path used to resolve relative thumbnail paths from the JSON to disk.
# Leave unset until thumbnails exist; image blocks are omitted when a file is missing.
THUMBNAIL_BASE_PATH=

# Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
LOG_LEVEL=INFO

# Models
EMBEDDING_MODEL=text-embedding-3-small
CLIP_MODEL=ViT-L/14
